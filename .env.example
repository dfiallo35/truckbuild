# Copy to .env and fill in. Never commit .env.

# --- API -------------------------------------------------------------------
# Host-side port is 5433 (see docker-compose.yml); inside Compose the API uses db:5432.
DATABASE_URL=postgresql+psycopg://truckbuild:truckbuild@localhost:5433/truckbuild
ENVIRONMENT=development

# Bearer token guarding /v1/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token

# Shared secret for the Next.js cache revalidation webhook. Must match the web app.
REVALIDATE_SECRET=dev-revalidate-secret
WEB_BASE_URL=http://localhost:3000

# Outbound mail. Leave unset in development -- the mailer logs instead of sending.
RESEND_API_KEY=
SALES_INBOX=sales@example.com
# Must be a sender Resend has verified for the domain, or delivery fails silently in production.
MAIL_FROM=TruckBuild <builds@example.com>

# Lead-form spam controls. Defaults are deliberately generous -- turning a real customer away
# costs more than storing a junk lead. Override only if a form is actually being abused.
# QUOTE_RATE_LIMIT=5
# QUOTE_RATE_LIMIT_WINDOW_SECONDS=600
# QUOTE_MIN_SUBMIT_MS=2500

# Origins allowed to call the API from a browser. Parsed as JSON because the setting is typed
# list[str] -- a bare `CORS_ORIGINS=https://truckbuild.com` fails at startup. The apex and the
# www. host are different origins; include both if both are used.
# CORS_ORIGINS=["https://truckbuild.com"]

# Error tracking. Unset is a supported configuration: the SDK stays inert and the structured
# per-request JSON logs still go to stdout. Set it in production only.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Stamped onto error reports so a regression can be pinned to a deploy. Fly sets this per release.
# RELEASE=

# --- Web -------------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ -- the browser must not see the API origin.
API_BASE_URL=http://localhost:8000

# The other half of the revalidation webhook, and it must be byte-identical to the API's. When
# these two drift apart nothing fails loudly -- catalog edits simply stop reaching the site.
# Set it in web/.env.local for local development.
REVALIDATE_SECRET=dev-revalidate-secret

# --- End-to-end specs (web/e2e) --------------------------------------------
# Where Playwright points. Unset means a local production build, which the config starts
# itself. Set it to a deployment to run the same specs against it (see docs/deploy.md).
# E2E_BASE_URL=https://truckbuild.com
# The lead-submitting spec stores a real quote and emails sales, so it refuses to run against
# a non-local target without this.
# E2E_ALLOW_WRITES=1
