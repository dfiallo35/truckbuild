# Environment
.env
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Playwright — run artifacts, not source. The specs in web/e2e/ are committed.
test-results/
playwright-report/
blob-report/
.playwright/

# CodeGraph — the symbol index is built from the source on each machine,
# so it is local state, not shared state. Never commit the database.
.codegraph/

# Model GLBs — large binaries `python -m app.assets sync` uploads to Blob (Stage 15).
# seed/catalog.yaml stays the reviewable, versioned half of the seed; these do not.
api/seed/models/

# LocalBlobStore's output — the dev/CI fallback for Vercel Blob when BLOB_READ_WRITE_TOKEN is
# unset. Generated by `python -m app.assets sync`, not source content.
web/public/models/

# OS / editor
.DS_Store
